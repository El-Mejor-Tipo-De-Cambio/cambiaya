---
interface Props {
  id: string;
  value: string;
  placeholder?: string;
}

const { id, value = '', placeholder = '0.00' } = Astro.props;
---

<div class="amount-input-wrapper">
  <div class="amount-input-container">
    <input
      type="text"
      id={id}
      class="amount-input"
      value={value}
      placeholder={placeholder}
      inputmode="decimal"
      autocomplete="off"
    />
    <div class="amount-controls">
      <button type="button" class="amount-btn amount-up" aria-label="Incrementar">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M6 2L10 8H2L6 2Z" fill="currentColor"/>
        </svg>
      </button>
      <button type="button" class="amount-btn amount-down" aria-label="Decrementar">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M6 10L2 4H10L6 10Z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="amount-in-words" id={`${id}-words`}></div>
</div>

<style>
  .amount-input-wrapper {
    width: 100%;
  }

  .amount-input-container {
    display: flex;
    align-items: stretch;
    background: var(--bg);
    border-radius: 16px;
    overflow: hidden;
    transition: background 0.15s;
  }

  .amount-input-container:focus-within {
    background: var(--surface);
    box-shadow: 0 0 0 2px var(--accent);
  }

  .amount-input {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    border: none;
    background: transparent;
    padding: 20px 16px;
    color: var(--text);
    letter-spacing: -0.02em;
    min-width: 0;
  }

  .amount-input:focus {
    outline: none;
  }

  .amount-input::placeholder {
    color: #CCCCCC;
    font-weight: 400;
  }

  .amount-input::-webkit-outer-spin-button,
  .amount-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .amount-input[type=number] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .amount-controls {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border);
    background: var(--surface);
  }

  .amount-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .amount-btn:hover {
    background: var(--accent);
    color: white;
  }

  .amount-btn:first-child {
    border-bottom: 1px solid var(--border);
  }

  .amount-up {
    border-radius: 0 16px 0 0;
  }

  .amount-down {
    border-radius: 0 0 16px 0;
  }

  .amount-in-words {
    font-family: var(--font-text);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: center;
    padding: 8px 16px;
    min-height: 24px;
    font-style: italic;
  }
</style>

<script>
  // Number to Spanish words converter
  function numberToSpanish(num: number): string {
    if (isNaN(num) || num === 0) return 'cero';

    const units = ['', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve'];
    const tens = ['diez', 'veinte', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta', 'ochenta', 'noventa'];
    const teens = ['dieci', 'dieci', 'dieci', 'dieci', 'dieci', 'dieci', 'dieci', 'dieci', 'dieci', 'dieci'];
    const hundreds = ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos', 'seiscientos', 'setecientos', 'ochocientos', 'novecientos'];

    const floor = Math.floor;
    const abs = Math.abs;

    function thousands(num: number): string {
      if (num === 0) return '';

      if (num < 10) {
        return units[num];
      }

      if (num < 20) {
        if (num === 10) return 'diez';
        return teens[num - 10] + units[num % 10];
      }

      if (num < 100) {
        const t = floor(num / 10);
        const u = num % 10;
        if (t === 2) return u === 0 ? 'veinte' : 'veinti' + units[u];
        return tens[t] + (u > 0 ? ' y ' + units[u] : '');
      }

      if (num < 1000) {
        const h = floor(num / 100);
        const rest = num % 100;
        if (num === 100) return 'cien';
        if (h === 5) return 'quinientos';
        if (h === 7) return 'setecientos';
        if (h === 9) return 'novecientos';
        return hundreds[h] + (rest > 0 ? ' ' + thousands(rest) : '');
      }

      if (num < 1000000) {
        const k = floor(num / 1000);
        const rest = num % 1000;
        if (k === 1) {
          return rest === 0 ? 'mil' : 'mil ' + thousands(rest);
        }
        return thousands(k) + ' mil' + (rest > 0 ? ' ' + thousands(rest) : '');
      }

      if (num < 1000000000) {
        const m = floor(num / 1000000);
        const rest = num % 1000000;
        const millionLabel = m === 1 ? 'millón' : 'millones';
        return thousands(m) + ' ' + millionLabel + (rest > 0 ? ' ' + thousands(rest) : '');
      }

      const b = floor(num / 1000000000);
      const restB = num % 1000000000;
      return thousands(b) + ' mil millones' + (restB > 0 ? ' ' + thousands(restB) : '');
    }

    const isNegative = num < 0;
    num = abs(num);

    const parts = num.toString().split('.');
    const integerPart = parseInt(parts[0], 10);
    const decimalPart = parts.length > 1 ? parseInt(parts[1].padEnd(2, '0').substring(0, 2), 10) : 0;

    let result = thousands(integerPart);

    if (decimalPart > 0) {
      result += ' con ' + decimalPart.toString().padStart(2, '0') + '/100';
    }

    return isNegative ? 'menos ' + result : result;
  }

  // Parse input string to number - handles multiple formats
  function parseAmount(value: string): number {
    if (!value || value.trim() === '') return 0;

    // Remove all whitespace
    let cleaned = value.replace(/\s/g, '');

    // Count commas and dots
    const commaCount = (cleaned.match(/,/g) || []).length;
    const dotCount = (cleaned.match(/\./g) || []).length;

    // Determine decimal separator:
    // - If only one comma and no dots: comma is decimal (European: 1.234,56)
    // - If only one dot and no commas: dot is decimal (English: 1,234.56)
    // - If both exist: last one is decimal separator
    // - If multiple of same: first is thousands, last is decimal

    let normalized: string;
    let decimalSeparator: string;

    if (commaCount === 1 && dotCount === 0) {
      // European format: 1.234,56 or 1234,56
      decimalSeparator = ',';
      normalized = cleaned.replace(/\./g, '').replace(',', '.');
    } else if (dotCount === 1 && commaCount === 0) {
      // English format: 1234.56
      decimalSeparator = '.';
      normalized = cleaned.replace(/,/g, '');
    } else if (commaCount === 1 && dotCount === 1) {
      // Both present - determine which is decimal
      const commaIndex = cleaned.lastIndexOf(',');
      const dotIndex = cleaned.lastIndexOf('.');
      if (commaIndex > dotIndex) {
        // European: 1.234,56
        decimalSeparator = ',';
        normalized = cleaned.replace(/\./g, '').replace(',', '.');
      } else {
        // English: 1,234.56
        decimalSeparator = '.';
        normalized = cleaned.replace(/,/g, '');
      }
    } else if (commaCount > 1 && dotCount === 0) {
      // Multiple commas - European thousands, no decimal
      normalized = cleaned.replace(/,/g, '');
    } else if (dotCount > 1 && commaCount === 0) {
      // Multiple dots - English thousands, no decimal
      normalized = cleaned.replace(/\./g, '');
    } else {
      // Fallback: treat everything as part of number
      normalized = cleaned.replace(/[^\d.]/g, '');
    }

    const result = parseFloat(normalized);
    return isNaN(result) ? 0 : result;
  }

  // Format number for display with thousands separators
  function formatForDisplay(num: number): string {
    if (isNaN(num) || num === 0) return '';

    // Split into integer and decimal parts
    const parts = num.toString().split('.');
    const intPart = parts[0];
    const decPart = parts.length > 1 ? parts[1] : '';

    // Add thousands separators to integer part
    const formattedInt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    // Return with comma as decimal separator (Spanish format)
    return decPart ? `${formattedInt},${decPart}` : formattedInt;
  }

  // Update words display
  function updateWords(inputId: string, num: number) {
    const wordsEl = document.getElementById(`${inputId}-words`);
    if (!wordsEl) return;

    if (!num || num === 0 || isNaN(num)) {
      wordsEl.textContent = '';
      return;
    }

    try {
      const words = numberToSpanish(num);
      wordsEl.textContent = words.charAt(0).toUpperCase() + words.slice(1);
    } catch (e) {
      wordsEl.textContent = '';
    }
  }

  // Initialize all amount inputs
  document.querySelectorAll('.amount-input').forEach(input => {
    const el = input as HTMLInputElement;
    const wrapper = el.closest('.amount-input-container');

    // Handle input
    el.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      let value = target.value;

      // Keep only valid characters (digits, comma, dot)
      value = value.replace(/[^\d.,]/g, '');

      // Parse to number
      const num = parseAmount(value);

      // Only update if valid number
      if (!isNaN(num) && num >= 0) {
        // Format for display
        const formatted = formatForDisplay(num);
        if (formatted !== target.value) {
          // Save cursor position
          const cursor = target.selectionStart;
          target.value = formatted;
          // Restore cursor
          if (cursor !== null && cursor <= formatted.length) {
            target.setSelectionRange(cursor, cursor);
          }
        }

        // Update words
        updateWords(el.id, num);

        // Dispatch event
        el.dispatchEvent(new CustomEvent('amount-change', { detail: { value: num } }));
      }
    });

    // Increment/decrement buttons - decimals first!
    const upBtn = wrapper?.querySelector('.amount-up');
    const downBtn = wrapper?.querySelector('.amount-down');

    upBtn?.addEventListener('click', () => {
      const current = parseAmount(el.value);
      const newValue = Math.round((current + 0.01) * 100) / 100;
      const formatted = formatForDisplay(newValue);
      el.value = formatted;
      updateWords(el.id, newValue);
      el.dispatchEvent(new CustomEvent('amount-change', { detail: { value: newValue } }));
      el.focus();
    });

    downBtn?.addEventListener('click', () => {
      const current = parseAmount(el.value);
      const newValue = Math.max(0, Math.round((current - 0.01) * 100) / 100);
      const formatted = formatForDisplay(newValue);
      el.value = formatted;
      updateWords(el.id, newValue);
      el.dispatchEvent(new CustomEvent('amount-change', { detail: { value: newValue } }));
      el.focus();
    });

    // Initial words update if there's a value
    if (el.value) {
      const num = parseAmount(el.value);
      updateWords(el.id, num);
    }

    // Listen for external trigger events
    el.addEventListener('amount-trigger-calculate', () => {
      const num = parseAmount(el.value);
      el.dispatchEvent(new CustomEvent('amount-change', { detail: { value: num } }));
    });
  });

  // Re-initialize after Astro swaps
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll('.amount-input').forEach(input => {
      const el = input as HTMLInputElement;
      if (el.value) {
        const num = parseAmount(el.value);
        updateWords(el.id, num);
      }
    });
  });
</script>