{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@workers/*": ["workers/api/src/*"]
    }
  },
  "include": ["src/**/*", "workers/**/*"],
  "exclude": ["node_modules"]
}